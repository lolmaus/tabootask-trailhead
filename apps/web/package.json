{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3200",
    "build": "vite build && node scripts/static-output.mjs",
    "build:local": "VITE_CONVEX_URL=http://127.0.0.1:3212 VITE_CONVEX_SITE_URL=http://127.0.0.1:3213 pnpm build",
    "preview": "wrangler dev --port 3200",
    "deploy:probe": "wrangler deploy",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --project tsconfig.browser.json && tsc --project tsconfig.node.json && tsc --project tsconfig.playwright.json",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:integration": "node scripts/local-integration.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.6",
    "@repo/backend": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.6.33",
    "convex": "1.49.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.1"
  }
}
