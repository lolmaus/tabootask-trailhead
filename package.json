{
  "name": "tabootask-trailhead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:root:fix",
    "lint:root": "oxlint --deny-warnings --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\" .",
    "lint:root:fix": "oxlint --deny-warnings --fix --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\" .",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit --project tsconfig.node.json",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test:tooling": "node --test lib/*.test.mts",
    "prepare": "lefthook install",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
